rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Private profile metadata is written only by the authenticated owner.
    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'createdAt',
          'updatedAt', 'lastSignInAt', 'preferredLanguage'
        ]);
      allow update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'updatedAt',
          'lastSignInAt', 'preferredLanguage'
        ]);
      allow delete: if false;

      // All future student feature collections inherit this UID boundary.
      match /{collection}/{document=**} {
        allow read, create, update, delete: if owns(uid);
      }
    }

    // Catalog records are readable to signed-in students. Admin writes require
    // a custom claim provisioned by a trusted server-side administrator tool.
    match /examCatalog/{examId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.token.admin == true;
    }

    match /examCycles/{cycleId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.token.admin == true;
    }
  }
}
